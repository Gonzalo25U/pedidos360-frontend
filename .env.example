# Copia este archivo a .env y completa con tus valores reales.

# Client ID de Pedidos360-Frontend (App Registration del frontend en Azure AD)
VITE_AZURE_FRONTEND_CLIENT_ID=f9b0d953-5e2c-4df9-8407-aa76b7a1d74f

# Client ID de Pedidos360-API (App Registration del backend en Azure AD)
VITE_AZURE_API_CLIENT_ID=11ca102e-9f51-438c-94d6-5c0bf54920b7

# URL base del API Gateway (invoke URL). Usa el ambiente de desarrollo por
# defecto, que tiene el set completo de rutas (incluidas /api/carrito y
# /api/pedidos exactas). El ambiente de produccion solo tiene rutas publicas
# + proxy+, asi que /api/carrito y /api/pedidos "a secas" (sin nada despues)
# no resuelven ahi todavia.
VITE_API_BASE_URL=aqui_va_la_url_del_api_gateway
