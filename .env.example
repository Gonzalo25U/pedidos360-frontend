# Copia este archivo a .env y completa con tus valores reales.

# Client ID de Pedidos360-Frontend (App Registration del frontend en Azure AD)
VITE_AZURE_FRONTEND_CLIENT_ID=

# Client ID de Pedidos360-API (App Registration del backend en Azure AD)
VITE_AZURE_API_CLIENT_ID=

# URL base del API Gateway (invoke URL), INCLUYENDO el nombre del stage.
VITE_API_BASE_URL=

# Redirect URI que se registra en Azure AD (Pedidos360-Frontend > Authentication
# > Single-page application). Cuando el frontend se sirve DETRAS del API
# Gateway (via una ruta {proxy+}), esta URL es la misma que VITE_API_BASE_URL
# pero con un "/" al final - Azure exige coincidencia EXACTA con lo registrado.
VITE_REDIRECT_URI=

# Subruta bajo la que vive la app cuando el Gateway la sirve (para que React
# Router resuelva /carrito, /pedidos, etc. correctamente). Dejar vacio en
# desarrollo local (la app vive en la raiz, http://localhost:4200/).
VITE_BASE_PATH=/desarrollo

# --- Amazon Cognito (segundo proveedor de login) ---
# Dominio del Hosted UI (sin barra final) y Client ID del app client.
# El callback/sign-out URL registrado en Cognito debe ser IGUAL a VITE_REDIRECT_URI.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
